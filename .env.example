# ========================
# SERVER CONFIGURATION
# ========================
NODE_ENV=production
PORT=3000

# ========================
# MONGODB CONFIGURATION
# ========================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/growex_capital?retryWrites=true&w=majority

# ========================
# JWT CONFIGURATION
# ========================
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRE=7d

# ========================
# TELEGRAM BOT CONFIGURATION
# ========================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
BOT_USERNAME=YourBotUsername

# ========================
# ADMIN CONFIGURATION
# ========================
# Comma-separated list of Telegram user IDs who are admins
ADMIN_TELEGRAM_IDS=123456789,987654321
# Admin notification channel (optional, Telegram channel/group ID)
ADMIN_CHAT_ID=123456789

# ========================
# DEPOSIT WALLET
# ========================
TRC20_WALLET_ADDRESS=TYourTRC20WalletAddressHere
NETWORK=TRC20 (TRON)

# ========================
# REFERRAL CONFIGURATION
# ========================
REFERRAL_BONUS_PERCENTAGE=5
MIN_DEPOSIT_FOR_REFERRAL=10

# ========================
# WITHDRAWAL CONFIGURATION
# ========================
MIN_WITHDRAWAL_AMOUNT=10
MAX_WITHDRAWAL_AMOUNT=10000
WITHDRAWAL_FEE_PERCENTAGE=1

# ========================
# RATE LIMITING
# ========================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ========================
# CORS
# ========================
CORS_ORIGIN=*

# ========================
# LOGGING
# ========================
LOG_LEVEL=info
LOG_DIR=./logs
